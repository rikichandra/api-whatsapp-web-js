NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Shared secret. Laravel calls this engine with:
#   Authorization: Bearer <SERVICE_TOKEN>
#   or header X-Api-Token
SERVICE_TOKEN=change-me

DEFAULT_SESSION=main
SESSION_DIR=./sessions
AUTO_START_SESSIONS=true

# Optional Chrome. Engine auto-detects installed Google Chrome on Windows.
# Set these if it runs as a Windows service / SYSTEM account.
# PUPPETEER_CACHE_DIR=C:\Users\user\.cache\puppeteer
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Logs browser console messages and failed/4xx+ requests. Use temporarily to
# diagnose a session stuck loading (browser launches but never reaches QR/ready).
# DEBUG_BROWSER=true

# Pins the WhatsApp Web client bundle version instead of always loading WA's
# current live version. WA periodically ships a web bundle that whatsapp-web.js
# can't parse yet (module resolution errors), which hangs every boot for 60s
# and crash-loops forever ("Waiting failed: 60000ms exceeded"). If that happens
# again, find a newer known-good version (e.g. from
# https://github.com/WhiskeySockets/wa-version/blob/main/data/versions.json)
# and update both this value and src/services/sessionManager.js's default.
WEB_VERSION=2.3000.1046959651
